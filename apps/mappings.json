{
  "generic": {
    "objectType": "http://schema.org/MediaObject",
    "children": {
      "http://schema.org/identifier": {
        "properties": [
          "dataLocationPredicate"
        ],
        "dataType": "Text"
      },
      "http://schema.org/alternateName": {
        "properties": [
          "fileNamePredicate"
        ],
        "dataType": "Text"
      },
      "http://schema.org/encodingFormat": {
        "properties": [
          "fileFormatPredicate"
        ],
        "dataType": "Text"
      },
      "http://schema.org/text": {
        "properties": [
          "textContentPredicate"
        ],
        "dataType": "Text"
      },
      "http://schema.org/dateModified": {
        "properties": [
          "dcterms:modified"
        ],
        "dataType": "DateTime"
      }
    }
  },

  "dataMappings": [
    {
      "types": [
        "text/plain",
        "text/csv",
        "application/pdf"
      ],
      "conf": {
        "objectType": "http://schema.org/MediaObject",
        "children": {
          "http://schema.org/name": {
            "properties": [
              "resourceName"
            ],
            "dataType": "Text"
          }
        }
      }
    },
    {
      "types": [
        "text/html",
        "application/xhtml+xml"
      ],
      "conf": {
        "objectType": "http://schema.org/MediaObject",
        "children": {
          "http://schema.org/name": {
            "properties": [
              "dc:title"
            ],
            "dataType": "Text"
          }
        }
      }
    },
    {
      "types": [
        "video/quicktime",
        "video/x-m4v",
        "video/mp4"
      ],
      "conf": {
        "objectType": "http://schema.org/VideoObject",
        "children": {
          "http://schema.org/dateCreated": {
            "properties": [
              "dcterms:created"
            ],
            "dataType": "DateTime"
          },
          "http://schema.org/name": {
            "properties": [
              "dc:title"
            ],
            "dataType": "Text"
          },
          "http://schema.org/author": {
            "objectType": "http://schema.org/Person",
            "children": {
              "http://schema.org/name": {
                "properties": [
                  "xmpDM:artist"
                ],
                "dataType": "Text"
              }
            }
          },
          "http://schema.org/isPartOf": {
            "objectType": "http://schema.org/MusicAlbum",
            "children": {
              "http://schema.org/name": {
                "properties": [
                  "xmpDM:album"
                ],
                "dataType": "Text"
              }
            }
          }
        }
      }
    },
    {
      "types": [
        "audio/mpeg",
        "audio/mp4"
      ],
      "conf": {
        "objectType": "http://schema.org/AudioObject",
        "children": {
          "http://schema.org/genre": {
            "properties": [
              "xmpDM:genre"
            ],
            "dataType": "Text"
          },
          "http://schema.org/name": {
            "properties": [
              "dc:title"
            ],
            "dataType": "Text"
          },
          "http://schema.org/author": {
            "objectType": "http://schema.org/Person",
            "children": {
              "http://schema.org/name": {
                "properties": [
                  "xmpDM:artist"
                ],
                "dataType": "Text"
              }
            }
          },
          "http://schema.org/isPartOf": {
            "objectType": "http://schema.org/MusicAlbum",
            "children": {
              "http://schema.org/name": {
                "properties": [
                  "xmpDM:album"
                ],
                "dataType": "Text"
              }
            }
          }
        }
      }
    },
    {
      "types": ["image/jpeg"],
      "conf": {
        "objectType": "http://schema.org/ImageObject",
        "children": {
          "http://schema.org/dateCreated": {
            "properties": [
              "dcterms:created"
            ],
            "dataType": "DateTime"
          },
          "http://schema.org/contentLocation": {
            "objectType": "http://schema.org/Place",
            "children": {
              "http://schema.org/geo": {
                "objectType": "http://schema.org/GeoCoordinates",
                "children": {
                  "http://www.opengis.net/ont/geosparql#asWKT": {
                    "properties": [
                      "GPS:GPS Latitude", "GPS:GPS Longitude"
                    ],
                    "dataType": "Geo"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "types": ["text/calendar"],
      "conf": {
        "objectType": "http://schema.org/Event",
        "children": {
          "http://schema.org/name": {
            "properties": [
              "dc:title"
            ],
            "dataType": "Text"
          },
          "http://schema.org/description": {
            "properties": [
              "dc:description"
            ],
            "dataType": "Text"
          },
          "http://schema.org/startDate": {
            "properties": [
              "xmp:MetadataDate"
            ],
            "dataType": "DateTime"
          },
          "http://schema.org/location": {
            "objectType": "http://schema.org/Place",
            "children": {
              "http://schema.org/geo": {
                "objectType": "http://schema.org/GeoCoordinates",
                "children": {
                  "http://www.opengis.net/ont/geosparql#asWKT": {
                    "properties": [
                      "geo:lat", "geo:long"
                    ],
                    "dataType": "Geo"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "types": [
        "message/rfc822"
      ],
      "conf": {
        "objectType": "http://schema.org/EmailMessage",
        "children": {
          "http://schema.org/name": {
            "properties": [
              "dc:title"
            ],
            "dataType": "Text"
          },
          "http://schema.org/dateSent": {
            "properties": [
              "dcterms:created"
            ],
            "dataType": "DateTime"
          },
          "http://schema.org/toRecipient": {
            "objectType": "http://schema.org/ContactPoint",
            "children": {
              "http://schema.org/email": {
                "properties": [
                  "Message-To"
                ],
                "dataType": "Text"
              }
            }
          },
          "http://schema.org/ccRecipient": {
            "objectType": "http://schema.org/ContactPoint",
            "children": {
              "http://schema.org/email": {
                "properties": [
                  "Message-Cc"
                ],
                "dataType": "Text"
              }
            }
          },
          "http://schema.org/sender": {
            "objectType": "http://schema.org/Person",
            "children": {
              "http://schema.org/email": {
                "properties": [
                  "Message:From-Email"
                ],
                "dataType": "Text"
              },
              "http://schema.org/name": {
                "properties": [
                  "Message:From-Name"
                ],
                "dataType": "Text"
              }
            }
          }
        }
      }
    }
  ]
}
